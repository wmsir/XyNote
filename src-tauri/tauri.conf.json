{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XyNote",
  "mainBinaryName": "XyNote",
  "version": "../package.json",
  "identifier": "com.meng.notiondesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小悦 (XyNote)",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "category": "Productivity",
    "shortDescription": "小悦笔记 XyNote - 本地优先的块级笔记与多维表格",
    "longDescription": "小悦笔记 XyNote 是一款本地优先的跨平台桌面笔记，支持块级大纲编辑、多维表格、磁盘 Markdown 直编与多端同步，原生支持银河麒麟 KylinOS、统信 UOS、Ubuntu、Debian、Fedora、openEuler（x86_64 / ARM64）。",
    "linux": {
      "deb": {
        "section": "editors",
        "priority": "optional"
      },
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
